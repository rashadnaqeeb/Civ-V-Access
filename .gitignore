# Local planning notes (not part of the shipped mod)
.planning/

# Build artifacts (always regenerated)
*.obj
*.o
*.exp
*.pdb
*.ilk
*.res
*.user
*.suo

# Build directories
build/
out/
bin/
obj/
x64/
Debug/
Release/

# IDE / editor
.vs/
.vscode/
.idea/
# Ignore Claude Code local state everywhere (e.g. docs/.claude), but publish
# the project-specific skills under the repo-root .claude.
.claude/
!/.claude/
/.claude/*
!/.claude/skills/
# Re-include the release skill: the case-insensitive Release/ rule above
# (meant for build output) otherwise swallows the release/ skill folder.
!/.claude/skills/release/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log

# Tolk source-tree build outputs (keep source, drop artifacts).
# The redistributable binaries live in third_party/tolk/dist/ and libs/ and are tracked.
third_party/tolk/src/*.dll
third_party/tolk/src/*.lib

# Local-only config (game install path, personal overrides)
local.config
local.*.ini

# Locally-installed developer tools (luacheck, etc.)
tools/bin/

# Translation pipeline scratch and locale-onboarding tooling. The shipped
# strings files live in src/dlc/UI/.../*_<locale>.lua and are tracked there;
# the per-batch source slices, agent prompt templates, and slicer/concat
# scripts under tools/translation/ are maintainer-local working tools that
# stay out of git history.
tools/translation/
build/translation/

# RemuxToAsf is a built-from-source C# helper; the .exe is regenerated on demand
tools/RemuxToAsf.exe

# luacheck cache
.luacheckcache

# Python bytecode cache from tools/*.py
__pycache__/
*.pyc

# Extracted leader scene images (Firaxis assets — not redistributable)
/leader images/

# Extracted unit selection sounds (Firaxis assets — not redistributable)
/unit-sounds/

# Extracted world wonder splash images (Firaxis assets — not redistributable)
/wonder images/

# Extracted natural wonder portraits (Firaxis assets — not redistributable)
/natural wonder images/

# Extracted victory/defeat screen stills (Firaxis assets — not redistributable)
/victory images/

# Extracted era popup paintings (Firaxis assets — not redistributable)
/era images/

# Extracted city-state trait background paintings (Firaxis assets — not redistributable)
/city-state images/

# Extracted World Congress session and project splashes (Firaxis assets — not redistributable)
/congress images/

# Extracted Dawn of Man load screen paintings (Firaxis assets — not redistributable)
/dawn of man images/

# Release artifacts produced by package-release.ps1. The GitHub Release is the
# source of truth for shipped binaries; the local zips are byproducts.
dist/release/

# dist/installer/CivVAccessInstaller.exe IS committed - the file at that path
# gives players a stable raw link
# (https://github.com/rashadnaqeeb/Civ-V-Access/raw/main/dist/installer/CivVAccessInstaller.exe)
# that survives across releases. Rebuild via build-installer.ps1 only when
# installer/ source changed since the last release; commit the new exe in the
# same commit as the corresponding versions.json + CHANGELOG bump.
